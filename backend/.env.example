# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/smart-exam-platform
# or MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/smart-exam-platform

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# SMTP Email Configuration (For Forgot Password)
# If left blank, the app will automatically use a fake Ethereal account for testing
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
