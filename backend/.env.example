PORT=5000

# ── MySQL database (production) ──
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mcqprosc_NewMCQPro
DB_USER=mcqprosc_NewMCQPro
DB_PASS=fVvMEKTzSFUwCSVX2PBR

# Only used by scripts/export-mongo.js during the one-time MongoDB→MySQL migration.
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxx.mongodb.net/dbname?retryWrites=true&w=majority

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=change_me

# AES Encryption (must be exactly 32 chars key / 16 chars IV)
AES_SECRET_KEY=00000000000000000000000000000000
AES_IV=0000000000000000

# Blockchain (leave private key / contract empty to run in offline-seal mode)
BLOCKCHAIN_NETWORK=https://sepolia.infura.io/v3/YOUR_KEY
CONTRACT_ADDRESS=
DEPLOYER_PRIVATE_KEY=

# AI Service (OpenAI for PDF MCQ extraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS — your live domain(s), comma-separated
ALLOWED_ORIGINS=https://mcqpros.com,https://www.mcqpros.com

# Node Environment
NODE_ENV=production
